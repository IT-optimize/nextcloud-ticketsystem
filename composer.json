{
	"name": "co-optimize/ticketsystem",
	"description": "Customer support tickets inside Nextcloud",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"autoload": {
		"psr-4": {
			"OCA\\TicketSystem\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\TicketSystem\\Tests\\": "tests/"
		}
	},
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5"
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true
	}
}
